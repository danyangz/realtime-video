# 复制成 .env 再填 key：  cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。

# 必填：语音识别（Whisper）和 TTS（Qwen3-TTS）都走 Together
TOGETHER_API_KEY=

# 选填：想让 LLM 走 OpenRouter 时再填，并把 LLM_PROVIDER 改成 openrouter
OPENROUTER_API_KEY=

# ---- LLM（只用开源权重模型）----
LLM_PROVIDER=together
# 留空则用默认：together -> Qwen/Qwen3.5-9B，openrouter -> qwen/qwen3.6-35b-a3b
LLM_MODEL=

# ---- TTS ----
# Qwen3-TTS 中文音色：vivian / serena（女），uncle_fu（男），dylan（北京话），eric（四川话）
TTS_VOICE=vivian
# TTS_INSTRUCTIONS=用自然、亲切、轻松的语气说话，像和朋友聊天。

# ---- 轮流说话 ----
# 你停顿多久算说完（毫秒）。经常被抢话就调大，嫌反应慢就调小。
VAD_MIN_SILENCE_MS=600
# 说话时能否打断小星
BARGE_IN=true
