# 复制成 .env 再填 key：  cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。

# 必填：TTS（Qwen3-TTS）和默认的 LLM 走 Together
TOGETHER_API_KEY=

# 选填：想让 LLM 走 OpenRouter 时再填，并把 LLM_PROVIDER 改成 openrouter
OPENROUTER_API_KEY=

# ---- LLM（只用开源权重模型）----
LLM_PROVIDER=together
# 留空则用默认：together -> Qwen/Qwen3.5-9B，openrouter -> qwen/qwen3.6-35b-a3b
LLM_MODEL=

# ---- 语音识别 ----
# local：在本机跑 Qwen3-ASR（Apple 芯片 Mac 的默认值）；together：用 Together 的 Whisper
# STT_ENGINE=local
# 额外的人名、专有名词等容易认错的词，用空格分隔（各应用已有自己的热词，比如"小星"、狼人杀术语）
# ASR_HOTWORDS=
# 最终识别用的模型（准）和实时字幕用的模型（快）
# ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
# ASR_PARTIAL_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit

# ---- TTS ----
# Qwen3-TTS 中文音色：vivian / serena（女），uncle_fu（男），dylan（北京话），eric（四川话）
TTS_VOICE=vivian
# TTS_INSTRUCTIONS=用自然、亲切、轻松的语气说话，像和朋友聊天。

# ---- 狼人杀 ----
# AI 玩家用的模型（只填开源权重模型）。逗号分隔多个时轮流分给各座位，可以比较谁更会玩
# WEREWOLF_MODELS=together:deepseek-ai/DeepSeek-V4.1-Flash
# 每段发言的字数上限
# WEREWOLF_SPEECH_CHARS=150
# 用脚本 AI 代替模型（调界面用，不调用模型）
# WEREWOLF_FAKE_AI=false

# ---- 视频聊天：轮流说话 ----
# 你停顿多久算说完（毫秒）。经常被抢话就调大，嫌反应慢就调小。
VAD_MIN_SILENCE_MS=600
# 说话时能否打断小星
BARGE_IN=true
